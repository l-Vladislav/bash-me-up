{
  "name": "bash-me-up",
  "version": "1.0.0",
  "private": true,
  "description": "Retro CRT terminal portfolio of Vladislav Larionov",
  "type": "module",
  "license": "MIT",
  "author": "Vladislav Larionov",
  "homepage": "https://l-vladislav.github.io/bash-me-up/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l-Vladislav/bash-me-up.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p stats",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "stats:deploy": "wrangler deploy --config stats/wrangler.toml"
  },
  "dependencies": {
    "@fontsource/vt323": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
